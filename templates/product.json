    "section_xgMN8V": {
      "type": "section",
      "blocks": {
        "custom_liquid_jcQYmU": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign p = product\n  assign notes = p.metafields.custom.notes_text.value\n  assign show_notes = false\n  if notes and notes.size >= 3\n    assign show_notes = true\n  endif\n  if p.handle == 'white-oud' or p.handle == 'black-oud'\n    assign show_notes = false\n  endif\n-%}\n{%- capture q1 -%}What does {{ p.title }} smell like?{%- endcapture -%}\n{%- capture a1 -%}Top notes: {{ notes[0] }}. Heart: {{ notes[1] }}. Base: {{ notes[2] }}.{%- endcapture -%}\n{%- capture q2 -%}What size and concentration is {{ p.title }}?{%- endcapture -%}\n{%- capture a2 -%}{{ p.title }} is a 100ml Eau de Parfum from the Illuminum London Core Range.{%- endcapture -%}\n{%- capture q3 -%}Is {{ p.title }} unisex?{%- endcapture -%}\n{%- capture a3 -%}Yes. Every Illuminum fragrance is unisex. We do not formulate for one gender; the wearer decides.{%- endcapture -%}\n{%- capture q4 -%}Is shipping free?{%- endcapture -%}\n{%- capture a4 -%}Yes. Shipping is free on every order to the UK and the US. UK orders usually arrive within 3–5 business days of dispatch, US orders within 5–10. Customs duties or taxes on US orders, if any, are paid by the customer.{%- endcapture -%}\n{%- capture q5 -%}Can I return a fragrance?{%- endcapture -%}\n{%- capture a5 -%}Yes, within 30 days of purchase, if the fragrance is unopened with the original seal intact. Opened fragrances cannot be returned for hygiene reasons. Return shipping is paid by the customer.{%- endcapture -%}\n{%- capture q6 -%}How can I contact Illuminum London?{%- endcapture -%}\n{%- capture a6 -%}Email orders@illuminum.london and we will reply as soon as we can.{%- endcapture -%}\n\n<div class=\"il-product-faq\">\n  <h2>Frequently asked questions</h2>\n  {%- if show_notes -%}<details><summary>{{ q1 }}</summary><p>{{ a1 }}</p></details>{%- endif -%}\n  <details><summary>{{ q2 }}</summary><p>{{ a2 }}</p></details>\n  <details><summary>{{ q3 }}</summary><p>{{ a3 }}</p></details>\n  <details><summary>{{ q4 }}</summary><p>{{ a4 }} <a href=\"/policies/shipping-policy\">Shipping policy</a>.</p></details>\n  <details><summary>{{ q5 }}</summary><p>{{ a5 }} <a href=\"/policies/refund-policy\">Refund policy</a>.</p></details>\n  <details><summary>{{ q6 }}</summary><p>Email <a href=\"mailto:orders@illuminum.london\">orders@illuminum.london</a> and we will reply as soon as we can.</p></details>\n</div>\n\n<style>\n  .il-product-faq {\n    width: 100% !important;\n    max-width: 860px;\n    margin: 64px auto !important;\n    padding: 0 16px;\n    box-sizing: border-box;\n    align-self: center;\n    font-family: var(--font-secondary--family, var(--font-body--family));\n    color: var(--color-foreground);\n  }\n  .il-product-faq h2 {\n    font-family: var(--font-h2--family, var(--font-primary--family));\n    font-weight: var(--font-h2--weight, 400);\n    font-size: 28px;\n    text-align: center;\n    margin-bottom: 24px;\n  }\n  .il-product-faq details {\n    border-bottom: 1px solid #e0e0e0;\n    padding: 20px 0;\n  }\n  .il-product-faq summary {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 16px;\n    font-family: var(--font-h6--family, var(--font-body--family));\n    font-weight: var(--font-h6--weight, 500);\n    font-size: 18px;\n    cursor: pointer;\n    list-style: none;\n  }\n  .il-product-faq summary::-webkit-details-marker { display: none; }\n  .il-product-faq summary::after {\n    content: '+';\n    font-size: 22px;\n    font-weight: 400;\n    flex-shrink: 0;\n  }\n  .il-product-faq details[open] summary::after { content: '–'; }\n  .il-product-faq p {\n    font-family: var(--font-secondary--family, var(--font-body--family));\n    font-size: var(--font-size--body-lg, 16px);\n    line-height: 1.7;\n    margin: 12px 0 0;\n  }\n  .il-product-faq a { color: inherit; text-decoration: underline; }\n</style>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {%- if show_notes -%}\n    { \"@type\": \"Question\", \"name\": {{ q1 | json }}, \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": {{ a1 | json }} } },\n    {%- endif -%}\n    { \"@type\": \"Question\", \"name\": {{ q2 | json }}, \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": {{ a2 | json }} } },\n    { \"@type\": \"Question\", \"name\": {{ q3 | json }}, \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": {{ a3 | json }} } },\n    { \"@type\": \"Question\", \"name\": {{ q4 | json }}, \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": {{ a4 | json }} } },\n    { \"@type\": \"Question\", \"name\": {{ q5 | json }}, \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": {{ a5 | json }} } },\n    { \"@type\": \"Question\", \"name\": {{ q6 | json }}, \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": {{ a6 | json }} } }\n  ]\n}\n</script>"
          },
